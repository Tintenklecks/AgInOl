# Template for App Store Connect API key credentials used by Fastfile's
# app_store_connect_api_key action. Copy this file to `fastlane/.env`
# (gitignored) and fill in your real values there — never commit real
# credentials or the .p8 key file itself.
#
# Where to get these values:
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
# -> Team Keys -> "+" to generate a new key (needs Admin/App Manager role)
#
# ASC_KEY_ID        The Key ID shown next to the key, e.g. "ABC123DEFG"
# ASC_ISSUER_ID     The Issuer ID shown at the top of the Keys page (a UUID)
# ASC_KEY_FILEPATH  Path to the downloaded AuthKey_<ASC_KEY_ID>.p8 file
#                    (you only get to download it once when you create the key)

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=./fastlane/AuthKey_XXXXXXXXXX.p8
