# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

require "tempfile"
require "shellwords"
require "json"

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      duration: 1200,
      in_house: false
    )
  end

  # `deliver` only has "run" (upload) options as a Fastfile action; the
  # download_metadata/download_screenshots modes are CLI-only subcommands,
  # so we shell out to them. The API key is written to a throwaway tempfile
  # for the duration of the call and never touches the repo.
  def run_deliver_download(subcommand)
    key_content = File.read(File.expand_path(ENV.fetch("ASC_KEY_FILEPATH")))
    Tempfile.create(["asc_api_key", ".json"]) do |file|
      file.write({
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key: key_content,
        duration: 1200,
        in_house: false
      }.to_json)
      file.flush

      metadata_path = File.join(__dir__, "metadata").shellescape
      screenshots_path = File.join(__dir__, "screenshots").shellescape
      sh("DELIVER_API_KEY_PATH=#{file.path.shellescape} bundle exec fastlane deliver #{subcommand} " \
         "--metadata_path #{metadata_path} --screenshots_path #{screenshots_path} --force")
    end
  end

  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(scheme: "AgInOlUITests")
  end

  desc "Download existing metadata (descriptions, keywords, etc.) from App Store Connect"
  lane :download_metadata do
    run_deliver_download("download_metadata")
  end

  desc "Download existing screenshots from App Store Connect"
  lane :download_appstore_screenshots do
    run_deliver_download("download_screenshots")
  end

  desc "Download everything currently live on App Store Connect (metadata + screenshots)"
  lane :download_all do
    run_deliver_download("download_metadata")
    run_deliver_download("download_screenshots")
  end

  desc "Upload all local metadata and screenshots to App Store Connect"
  lane :upload_all do
    deliver(
      metadata_path: File.join(__dir__, "metadata"),
      screenshots_path: File.join(__dir__, "screenshots"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
